<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Прогноз из интернета. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Место для погоды «там, где вы». Точное по умолчанию (решение Димы 07.11.2026); человек в системном окне
         может оставить приблизительное, приложение работает и с ним. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Уведомление о погоде (0.7.0): спрашивается, только когда человек включает его в настройках. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Фоновое обновление уведомления ждёт сети (JobInfo.setRequiredNetworkType): с Android 14 без этого права система
         не ставит такую задачу и закрывает приложение (так падали 0.7.0 и 0.7.1). Окна не показывает. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Чтобы обновление уведомления пережило перезагрузку телефона (JobInfo.setPersisted). Само ничего не запускает. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Библиотека карты (MapLibre) просит ещё состояние Wi-Fi; её код его не читает (сверено 12.11.2026 по исходникам
         android-v13.7.1), поэтому право убрано из готового приложения. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PogodaApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Фоновое обновление уведомления о погоде; запускает только система (JobScheduler). -->
        <service
            android:name=".notify.WeatherJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
